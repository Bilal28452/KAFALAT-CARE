# Copy this file to ".env" and fill in the values. ".env" is never committed to Git.
FLASK_ENV=development
AI_SERVICE_PORT=5000
AI_SERVICE_URL=http://127.0.0.1:5000
# Shared secret used by the Django and Flask processes
AI_SERVICE_API_KEY=change-me-to-a-long-random-string

# Optional SMTP configuration for account and sponsorship notification emails.
# Without EMAIL_HOST, email messages use Django's development console backend.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=KafalatCare <noreply@example.com>
